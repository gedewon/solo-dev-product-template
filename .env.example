# Copy to .env.local and fill in. Never commit real values.
# Every variable the app reads must be listed here, with a comment saying
# where it comes from and whether it is safe to expose to the browser.

# Public (bundled into browser code because of the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Add these when the project adds Supabase ---
# NEXT_PUBLIC_SUPABASE_URL=            # public
# NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public, safe only because RLS is on for every table
# SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY. Bypasses RLS. Never import in client code.
